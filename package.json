{
  "name": "preeffects",
  "productName": "PreEffects",
  "version": "1.1.0",
  "description": "Professional, offline-first motion graphics and visual effects desktop workstation for macOS, Windows, and Linux.",
  "license": "MIT",
  "author": {
    "name": "PreEffects Contributors",
    "email": "maintainers@preeffects.dev",
    "url": "https://github.com/Kokonut-dev/PreEffects"
  },
  "homepage": "https://github.com/Kokonut-dev/PreEffects",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kokonut-dev/PreEffects.git"
  },
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:electron": "node scripts/build-electron.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run tests/unit tests/integration",
    "test:perf": "vitest run tests/performance",
    "test:all": "vitest run",
    "icons": "node scripts/generate-app-icons.mjs",
    "package:mac": "npm run build && electron-builder --mac --publish never --config packaging/electron-builder.json",
    "package:win": "npm run build && electron-builder --win --x64 --publish never --config packaging/electron-builder.json",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never --config packaging/electron-builder.json"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
