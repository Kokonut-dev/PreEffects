{
  "appId": "dev.preeffects.studio",
  "productName": "PreEffects",
  "copyright": "Copyright © 2026 PreEffects Contributors (MIT)",
  "publish": null,
  "npmRebuild": false,
  "afterPack": "packaging/afterPack.cjs",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "directories": {
    "buildResources": "packaging",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "LICENSE"
  ],
  "mac": {
    "category": "public.app-category.video",
    "icon": "packaging/icons/icon.png",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "entitlements": "packaging/entitlements.mac.plist",
    "entitlementsInherit": "packaging/entitlements.mac.plist",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "prex",
        "name": "PreEffects Studio Project",
        "role": "Editor"
      }
    ]
  },
  "dmg": {
    "sign": false,
    "writeUpdateInfo": false
  },
  "win": {
    "icon": "packaging/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "prex",
        "name": "PreEffects Studio Project"
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "msi": {
    "artifactName": "${productName}-Installer-${version}-${arch}.${ext}"
  },
  "linux": {
    "maintainer": "PreEffects Contributors <maintainers@preeffects.dev>",
    "vendor": "PreEffects Contributors",
    "category": "AudioVideo;Video;AudioVideoEditing;Graphics;",
    "icon": "packaging/icons",
    "synopsis": "Offline-First Motion Graphics & VFX Compositing Workstation",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "prex",
        "name": "PreEffects Studio Project",
        "mimeType": "application/x-preeffects-project"
      }
    ]
  }
}
